# Dashboard: Overzicht -- Media Player: osmc       -*- hass -*-
# WARNING: This is a generated file -- DO NOT EDIT

[%- IF sections == "cards"; sections = "grids"; END -%]

[% INCLUDE section.tt
       name = "Woonkamer"
       icon = "sofa"
       navigate = "/lovelace-overzicht/woonkamer" %]

      - [% WRAPPER mt_card.tt
                   entity = "climate.thermostat_hc1"
                   icon = "mdi:thermostat"
                   name   = "Thermostaat" %]
        color: green
        secondary: '{{ states("sensor.thermostat_setting") }} °C ({{ states("select.thermostat_hc1_mode")|capitalize }})'
        [% END %]

      - [% WRAPPER tile_card.tt
                   name    = "Suspend"
                   entity  = "sensor.thermostat_party_time"
                   visible = "not 0" %]
        tap_action:
          action: perform-action
          perform_action: number.decrement
          target:
            entity_id: number.thermostat_hc1_party
        hold_action:
          action: perform-action
          perform_action: number.increment
          target:
            entity_id: number.thermostat_hc1_party
        [% END %]

      - [% WRAPPER tile_card.tt
                   name    = "Tafel"
                   entity  = "light.woonkamer_tafel"
                   span    = 1 %]
        [% END %]

      - [% WRAPPER tile_card.tt
                   name   = "Music Center"
                   entity = "switch.woonkamer_sound_system" %]
        icon: mdi:music-circle-outline
        [% END %]

      - [% WRAPPER tile_card.tt
                   name    = "Picky (LMS)"
                   entity  = "media_player.picky_lms"
                   visible = "paused|playing"
                   %]
        [% END %]

      - [% WRAPPER tile_card.tt
                   name   = "Picky (MA)"
                   entity = "media_player.picky_ma"
                   visible = "paused|playing" %]
        [% END %]

#      - type: custom:mushroom-template-card
