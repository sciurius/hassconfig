#        secondary: >-
#          {{ states('sensor.woonkamer_temperature')|round(1) }} °C -
#          {{ states('sensor.woonkamer_humidity')|round(0) }} %
#        icon_tap_action:
#          action: more-info
#          entity: sensor.woonkamer_humidity
#        visibility:
#          - entity: sensor.woonkamer_temperature
#            <<: *v_available

      - type: custom:mushroom-template-card
        entity: sensor.buiten_beter_binnen
        icon: mdi:sun-snowflake
        color: >-
          {% if   states(entity)|int <  1 %} blue
          {% elif states(entity)|int < 10 %} green
          {% else %} red {% endif %}
        primary: Bu Be Bi
        secondary: "{{ states(entity) }} °C"

      - type: tile
        entity: light.binnenkerstverlichting1
        name: Kerstverlichting
        visibility:
          - entity: light.binnenkerstverlichting1
            <<: *v_available

