[% IF 0 %]
      - [% WRAPPER mt_card.tt
                   name   = "Bu Be Bi"
                   entity = "sensor.buiten_beter_binnen"
                   icon   = "mdi:sun-snowflake" %]
        color: >-
          {% if   states(entity)|int <  1 %} blue
          {% elif states(entity)|int < 10 %} green
          {% else %} red {% endif %}
        secondary: "{{ states(entity) }} °C"
        [% END %]
[% ELSE %]
      - [% WRAPPER hg_card.tt
                   name   = "Bu Be Bi"
                   entity = "sensor.buiten_beter_binnen"
                   icon   = "mdi:sun-snowflake"
                   color  = "segment"
                   %]
        max: 10
        needle: true
        needle_shadow: false
        needle_color: "#808080"
        show_segment_labels: false
        segment_label_position: below
        value_label_position: above
        segments:
          - value: -1
            color: "#18bcf2"
          - value: 1
            color: orange
          - value: 10
            color: "#00ff00"
        min: -10
        show_value: true
        decimals: 1
        smooth_gradients: false
        needle_label_position: below
        show_value_labels: false
        show_needle_label: false
        [% END %]
[% END %]

      - [% WRAPPER tile_card.tt
                   name    = "Kerstverlichting"
                   entity  = "light.binnenkerstverlichting1"
                   visible = "available" %]
        [% END %]
