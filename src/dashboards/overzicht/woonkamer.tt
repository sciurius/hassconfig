# Dashboard: Overzicht -- Media Player: osmc       -*- hass -*-
# WARNING: This is a generated file -- DO NOT EDIT

[% PROCESS v_anchors.tt %]

[% INCLUDE section.tt
       name = "Woonkamer"
       icon = "sofa"
       navigate = "/lovelace-overzicht/woonkamer" %]

      - type: custom:mushroom-template-card
        entity: climate.thermostat_hc1
        icon: mdi:thermostat
        color: green
        primary: Thermostaat
        secondary: '{{ states("sensor.thermostat_setting") }} °C ({{ states("select.thermostat_hc1_mode")|capitalize }})'

      - type: tile
        entity: light.woonkamer_tafel
        name: Tafel
        grid_options:
          columns: 6

      - type: tile
        entity: switch.woonkamer_sound_system
        name: Music Center
        icon: mdi:music-circle-outline

#      - type: custom:mushroom-template-card
#        primary: Temperatuur
#        icon: mdi:thermometer-water
#        color: var(--state-icon-color)
