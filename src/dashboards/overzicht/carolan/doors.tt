# Dashboard: Overzicht -- Carolan       -*- hass -*-
# WARNING: This is a generated file -- DO NOT EDIT

[% INCLUDE section.tt
       name   = "Auto Portieren"
       icon   = "car-hatchback"
       color  = "cornflowerblue"
       badges = [] %]

[%# Sensor controlled -%]
[% map = { "driverseat" => "Bestuurder",
           "passengerseat" => "Passagier",
           "leftrearseat" => "Links achter"
           "rightrearseat" => "Rechts achter" } %]
[% FOREACH seat IN [ "driverseat", "passengerseat", "rightrearseat", "leftrearseat" ]; item = "lock" %]
      - [% WRAPPER mt_card.tt
                   entity  = "binary_sensor.carolan_" _ seat _ "_" _ item
                   name    = map.$seat
                   icon    = "mdi:car-door-lock"
                   visible = "available"
                   %]
        color: >-
          {{ "green" if is_state(entity,'off') else "red" }}
        [% END %]

      - type: horizontal-stack
        cards:
[% FOREACH item IN [ "door", "window" ] %]
        - [% WRAPPER mt_card.tt
                     entity  = "binary_sensor.carolan_" _ seat _ "_" _ item
                     visible = "available"
                     %]
[%- IF item == 'door' %]
          icon: mdi:car-door
[%- ELSIF item == 'window' %]
          icon: mdi:window-closed[% END %]
          color: >-
            {{ "green" if is_state(entity,'off') else "red" }}
          [% END %]
[% END %]
[% END %]
[% FOREACH seat IN [ "trunk"] %]
      - [% WRAPPER mt_card.tt
                   entity  = "binary_sensor.carolan_" _ seat _ "_lock"
                   name    = "Kofferbak"
                   icon    = "mdi:car-door-lock"
                   visible = "available"
                   %]
        color: >-
          {{ "green" if is_state(entity,'off') else "red" }}
        [% END %]

      - type: horizontal-stack
        cards:
        - [% WRAPPER mt_card.tt
                     entity  = "binary_sensor.carolan_" _ seat
                     icon    = "mdi:car-door"
                   visible = "available"
                   %]
          color: >-
            {{ "green" if is_state(entity,'off') else "red" }}
          [% END %]

        - type: heading
[% END %]

[% FOREACH seat IN [ "hood" ] %]
      - [% WRAPPER mt_card.tt
                   entity  = "binary_sensor.carolan_" _ seat
                   name    = "Motorkap"
                   icon    = "mdi:car-door"
                   visible = "available"
                   %]
        color: >-
          {{ "green" if is_state(entity,'off') else "red" }}
        [% END %]
[% END %]
