# Dashboard: Overzicht -- Carolan       -*- hass -*-
# WARNING: This is a generated file -- DO NOT EDIT

[% INCLUDE section.tt
       name   = "Auto"
       icon   = "car-hatchback"
       navigate = "/lovelace-overzicht/carolan"
       badges   = [ "fuel" ]
       fuel_entity = "sensor.carolan_fuel_level"
       %]

      - [% WRAPPER mt_card.tt
                   entity  = "sensor.carolan_fuel_level"
                   name    = "Carolan"
                   icon    = "mdi:gas-station"
                   visible = "available"
                   %]
        color: >-
          {% if   states(entity)|int >= 30 %} [% dash.col.green %]
          {% elif states(entity)|int >= 15 %} orange
          {% else                          %} red
          {% endif %}
        secondary: >-
          {{ states(entity)|int }}%
          ({{ states('sensor.carolan_fuel_range')|int }} km)
        [% END %]

      - type: conditional
        conditions:
          - condition: state
            entity: binary_sensor.carolan_all_locks
            state_not:
              - unavailable
              - unknown
          - condition: state
            entity: binary_sensor.carolan_driverseat_lock
            state_not:
              - unknown
        card:
          [% WRAPPER mt_card.tt
                      entity  = "binary_sensor.carolan_all_locks"
                      name    = "Portieren"
                      %]
          icon: >-
            {% if is_state(entity, 'on') %}
            mdi:car-door-lock
            {% else %}
            mdi:car-door
            {% endif %}
          color: >-
            {% if is_state(entity, 'on') %}
            [% dash.col.green %]
            {% else %}
            [% dash.col.red %]
            {% endif %}
          secondary: >-
            {% if is_state(entity, 'on') %}
            Gesloten
            {% else %}
            Open
            {% endif %}
          [% END %]

      - [% WRAPPER mt_card.tt
                   entity  = "device_tracker.carolan_parking_location"
                   name    = "Locatie"
                   visible = "available"
                   %]
        icon: >-
          {% if is_state(entity,'home') %}
          mdi:home
          {% else %}
          mdi:car-hatchback
          {% endif %}
        color: >-
          {% if is_state(entity,'home') %}
          [% dash.col.green %]
          {% else %}
          [% dash.col.default %]
          {% endif %}
        secondary: >-
          {% if is_state(entity,'home') %}
          Thuis
          {% else %}
          {{ states(entity) }}
          {% endif %}
        tap_action:
          action: navigate
          navigation_path: /lovelace-trackers/trackercarolan
        [% END %]

      - [% WRAPPER tile_card.tt
                   entity  = "sensor.carolan_current_day_statistics"
                   name    = "Dag"
                   icon    = "mdi:map-marker-distance"
                   visible = "available"
                   %]
        [% END %]

      - [% WRAPPER mt_card.tt
                   entity  = "binary_sensor.carolan_vehicle_health"
                   name    = "Problemen"
                   icon    = "mdi:car-wrench"
                   visible = "available on"
                   %]
        primary: >-
          {{ "Probleem" if state_attr('binary_sensor.carolan_vehicle_health','warnings')|length == 1 else "Problemen" }}
        secondary: >-
          {{ state_attr('binary_sensor.carolan_vehicle_health','warnings')[0]['wngdesc'] }}
        icon: >-
          mdi:car-{{ "tire-alert" if state_attr('binary_sensor.carolan_vehicle_health','warnings')[0]['wngcode'] == 'TILW' else "wrench" }}
        color: >-
          {{ "orange" if state_attr('binary_sensor.carolan_vehicle_health','warnings')[0]['severity']|int <= 4 else "red" }}
        [% END %]

      - [% WRAPPER tile_card.tt
                   entity  = "sensor.carolan_current_week_statistics"
                   name    = "Week"
                   icon    = "mdi:map-marker-distance"
                   visible = "available"
                   %]
        [% END %]

      - [% WRAPPER tile_card.tt
                   entity  = "sensor.carolan_current_month_statistics"
                   name    = "Maand"
                   icon    = "mdi:map-marker-distance"
                   visible = "available"
                   %]
        [% END %]

      - [% WRAPPER tile_card.tt
                   entity  = "sensor.carolan_current_year_statistics"
                   name    = "Jaar"
                   icon    = "mdi:map-marker-distance"
                   visible = "available"
                   %]
        [% END %]

