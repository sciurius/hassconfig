# Dashboard: Overzicht -- Slaapkamer                     -*- hass -*-
# New design based on tile cards.

[% INCLUDE section.tt
       name     = "Slaapkamer"
       icon     = "bed"
       navigate = "/lovelace-overzicht/slaapkamer" %]


      # Media center tile.
      # Switches on/off the media center.
      # The icon changes with the media function selected.
      - type: custom:mushroom-template-card
        entity: switch.slaapkamer_media_center
        primary: Media Center
        secondary: >-
          {{ states("sensor.mc_state") }}
        color: |-
          {% if   is_state('sensor.mc_state', 'TV') %} #4caf50
          {% elif is_state('sensor.mc_state', 'Video') %} blue
          {% elif is_state('sensor.mc_state', 'ChromeCast') %} purple
          {% elif is_state('switch.slaapkamer_media_center','on') %} red
          {% else %} var(--state-inactive-color)
          {% endif %}
        icon: |-
          {% if   is_state('sensor.mc_state', 'TV') %} mdi:television-box
          {% elif is_state('sensor.mc_state', 'Video') %} mdi:movie-open
          {% elif is_state('sensor.mc_state', 'ChromeCast') %} mdi:cast-connected
          {% elif is_state('switch.slaapkamer_media_center','on') %} mdi:television-off
          {% else %} mdi:television
          {% endif %}

      # Avondlichtje.
      - [% WRAPPER tile_card.tt
                   entity = "light.slaapkamer_avondlichtje"
                   name = "Avondlichtje"
                   %]
        [% END %]

      - type: tile
        entity: switch.slaapkamer_media_center
        icon: mdi:television

#      - [% INCLUDE power_meter.tt
#           name = "Media Center" sensor = "slaapkamer_media_center"
#           icon = "television" %]

      - type: shortcut
        label: Media Center
        tap_action:
          action: navigate
          navigation_path: /lovelace-slaapkamerremote/0
        vertical: false
        icon: mdi:remote-tv
        visibility:
          - entity: switch.slaapkamer_media_center
            condition: state
            state: "on"

      - type: shortcut
        tap_action:
          action: navigate
          navigation_path: /lovelace-chromecast-slaapkamer/0
        vertical: false
        icon: mdi:remote-tv
        visibility:
          - entity: switch.slaapkamer_media_center
            condition: state
            state: "on"

           
      # Fan on/off switch.
      # Only visible if the fan exists.
      - [% WRAPPER tile_card.tt
                   entity = "switch.slaapkamer_fan"
                   visible = "available"
                   %]
        [% END %]

      # Fan timer.
      # Only visible when the timer is running.
      - [% WRAPPER tile_card.tt
                   entity = "timer.slaapkamer_fan"
                   name = "Timer"
                   icon = "mdi:fan"
                   visible = "available active"
                   %]
        [% END %]

      # Warmtedeken switch.
      # Only visible when the warmtedeken exists.
      - [% INCLUDE switching_meter.tt
           name = "\"Deken {% if is_state('automation.scheduled_switch_on_warmtedeken','on') %} (auto) {% endif %}\""
           sensor = "slaapkamer_warmtedeken"
           icon = "radiator" %]
        tap_action:
          action: perform-action
          perform_action: automation.toggle
          target:
              entity_id: automation.scheduled_switch_on_warmtedeken

#     # Warmtedeken automation.
#      # Only visible when the warmtedeken exists.
#      - type: tile
#        entity: automation.scheduled_switch_on_warmtedeken
#        name: Deken auto
#        color: false
#        visibility:
#          - entity: switch.slaapkamer_warmtedeken
#            <<: *v_available

      # Warmtedeken timer.
      # Only visible when the timer is running.
      - [% WRAPPER tile_card.tt
                   entity = "timer.slaapkamer_warmtedeken"
                   name = "Timer"
                   icon = "mdi:radiator"
                   visible = "available acive"
                   %]
        [% END %]
