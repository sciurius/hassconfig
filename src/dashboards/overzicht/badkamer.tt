# Dashboard: Overzicht -- Badkamer       -*- hass -*-
# WARNING: This is a generated file -- DO NOT EDIT

[% PROCESS colours.tt -%]

[% device = "itho_cve_s" %]

[% INCLUDE section.tt
       name     = "Badkamer"
       icon     = "bathtub"
       navigate = "/lovelace-overzicht/badkamer" %]

      - [% INCLUDE maybelight.tt
           entity = "light.badkamer_verlichting" %]

      - [% INCLUDE switching_meter.tt
           name = "Afzuiging"
           icon = "fan"
           alwayson = 2 %]
            
      - [% WRAPPER mt_card.tt
                   entity  = "sensor." _ device _ "_speed_status"
                   name    = "Afzuiging"
                   visible = ">-1"
                   %]
        icon: >-
          {% if   is_state('sensor.[% device %]_fan_info','auto') %}
          mdi:fan-auto
          {% elif is_state('sensor.[% device %]_fan_info','high') %}
          mdi:fan-speed-3
          {% elif is_state('sensor.[% device %]_fan_info','low') %}
          mdi:fan-speed-1
          {% elif is_state('sensor.[% device %]_fan_info','timer 1') %}
          mdi:fan-clock
          {% elif is_state('sensor.[% device %]_fan_info','timer 2') %}
          mdi:fan-clock
          {% elif is_state('sensor.[% device %]_fan_info','timer 3') %}
          mdi:fan-clock
          {% else %}
          mdi:fan
          {% endif %}
        color: >-
          {{ "[% dash.col.default %]"
             if (states('sensor.[% device %]_fan_speed')|int) > 0
             else "[% dash.col.inactive %]" }}
        secondary: |
          {% if (states('sensor.[% device %]_fan_speed')|int) > 0 %}
          {{ states('sensor.[% device %]_fan_speed') }} rpm
          {% if (states('sensor.[% device %]_ventilation_setpoint')|int) > 0 %}({{ states('sensor.[% device %]_ventilation_setpoint') }}%){% endif %}
          {% endif %}
        [% END %]

      - [% WRAPPER tile_card.tt
                   entity = "sensor." _ device _ "_remaining_time"
                   name = "Fan Timer"
                   visible = "available >0"
                   %]
        [% END %]
  
      - [% WRAPPER tile_card.tt
                   entity = "sensor.boiler_dhw_current_tap_water_flow"
                   name = "Warm water"
                   icon = "mdi:shower"
                   visible = "available >0"
                   %]
        [% END %]

      - [% INCLUDE switching_meter.tt
                   name = "Verwarming"
                   icon = "heat-wave"
                   sensor = "badkamerverwarming" %]
            
      - [% WRAPPER tile_card.tt
                   entity = "timer.badkamerverwarming"
                   name = "Timer"
                   icon = "mdi:radiator"
                   visible = "active"
                   %]
        [% END %]

