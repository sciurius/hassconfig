# Dashboard: Overzicht -- Woonkamer wand       -*- hass -*-
# WARNING: This is a generated file -- DO NOT EDIT

[% INCLUDE section.tt
   name   = "Verlichting"
   icon   = "sofa"
   entity = "woonkamer"
   badges = []
   %]

      - [% WRAPPER tile_card.tt
                   entity = "light.woonkamer_tafel"
                   name   = "Tafel"
                   icon   = "mdi:ceiling-light"
                   %]
        [% END %]

      - [% WRAPPER tile_card.tt
                   entity = "light.woonkamer_tafeltje"
                   name   = "Tafeltje"
                   icon   = "mdi:lamp"
                   %]
        [% END %]

      - [% WRAPPER tile_card.tt
                   entity = "light.woonkamer_hoek"
                   name   = "Hoek"
                   %]
        [% END %]

      - [% WRAPPER tile_card.tt
                   entity = "light.woonkamer_heks"
                   name   = "Heks"
                   icon   = "mdi:light-flood-down"
                   %]
        icon_hold_action:
          action: call-service
          service: light.toggle
          data:
            entity_id: light.woonkamer_heks
            brightness_pct: 100
            rgb_color: [191,0,255]
        [% END %]

      - [% WRAPPER tile_card.tt
                   entity = "light.woonkamer_totem"
                   name   = "Totem"
                   icon   = "mdi:light-flood-down"
                   %]
        icon_hold_action:
          action: call-service
          service: script.start_woonkamer_totem_timer
        [% END %]

      - [% INCLUDE switchoff_timer_tile.tt
                   name  = "Timer"
                   timer = "woonkamer_totem" %]

      - [% WRAPPER tile_card.tt
                   entity = "light.woonkamer_wand_l"
                   name   = "Links"
                   %]
        [% END %]

      - [% WRAPPER tile_card.tt
                   entity = "light.woonkamer_wand_r"
                   name   = "Rechts"
                   %]
        [% END %]

      - [% WRAPPER tile_card.tt
                   entity  = "light.binnenkerstverlichting1"
                   name    = "Kerstverlichting"
                   visible = "available"
                   %]
        [% END %]

