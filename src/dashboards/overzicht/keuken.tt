# Dashboard: Overzicht -- Keuken      -*- hass -*-
# WARNING: This is a generated file -- DO NOT EDIT

[% INCLUDE section.tt
       name     = "Keuken"
       icon     = "countertop"
       navigate = "/lovelace-overzicht/keuken" %]

      - type: tile
        entity: light.keuken_aanrecht_verlichting
        name: Aanrecht
        icon: mdi:ceiling-light-multiple-outline
        icon_tap_action:
          action: call-service
          service: mqtt.publish
          data:
            topic: cmnd/tasm19/add1
            payload: 1

      - type: tile
        entity: light.keuken_kook_verlichting
        name: Kookplaat
        icon: mdi:wall-sconce-flat-outline
        icon_tap_action:
          action: call-service
          service: mqtt.publish
          data:
            topic: cmnd/tasm22/add1
            payload: 1

      - [% INCLUDE switching_meter.tt
           name = "Boiler" sensor = "keukenboiler"
           icon = "water-boiler" alwayson = 1 %]
      - [% INCLUDE power_meter.tt
           name = "Vaatwasser" icon = "dishwasher" %]
      - [% INCLUDE switching_meter.tt
           name = "Koffie" sensor = "koffiespul"
           icon = "coffee-maker-outline" %]
#      - [%# INCLUDE switching_meter.tt
#           name = "Expresso" sensor = "expresso" icon = "coffee-maker" %]
      - [% INCLUDE switching_meter.tt
           name = "Koelkast" icon = "fridge" alwayson = 2 %]
      - [% INCLUDE power_meter.tt
           name = "Oven" icon = "toaster-oven" %]
        hold_action:
          action: navigate
          navigation_path: /lovelace-oven/0

      - type: conditional
        conditions:
        - condition: state
          entity: sensor.aeg_oven_targettemperature
          state_not:
            - unavailable
            - unknown
        - condition: state
          entity: sensor.aeg_oven_appliancestate
          state: "Running"
        card:
          [% WRAPPER mt_card.tt
                     entity = "sensor.aeg_oven_targettemperature"
                     name = "Oven"
                     icon = "mdi:thermostat"
                     %]
          color: red
          secondary: "{{ states('sensor.aeg_oven_displaytemperature') }} / {{ states('sensor.aeg_oven_targettemperature')|int }} °C"
          [% END %]

      - [% WRAPPER tile_card.tt
                   entity = "sensor.aeg_oven_starttime"
                   name = "Oven start"
                   visible = "available >0"
                   %]
        [% END %]

      - [% WRAPPER tile_card.tt
                   entity = "sensor.aeg_oven_runningtime"
                   name = "Oven"
                   visible = "available >0"
                   %]
        [% END %]

      - [% WRAPPER tile_card.tt
                   entity = "sensor.aeg_oven_timetoend"
                   name = "Stopt over"
                   visible = "available >1"
                   %]
        [% END %]
