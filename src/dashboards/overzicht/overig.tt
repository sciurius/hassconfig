# Dashboard: Overzicht -- Overig               -*- hass -*-
# WARNING: This is a generated file -- DO NOT EDIT

[% INCLUDE section.tt
       name     = "Overig"
       icon     = "cog-box"
       navigate = "/lovelace-overzicht/overig"
       badges   = [] %]

      [% FOREACH item IN [ "kelder", "kruipruimte", "zolder", "garage", "achterkamer", "badkamerachterwand" ] %]
      - [% WRAPPER mt_card.tt
                   entity  = "sensor." _  item _ "_temperature"
                   name    = item.ucfirst
                   icon    = "mdi:thermometer-water"
                   %]
        color: var(--state-icon-color)
        secondary: >-
          {{ states('sensor.[% item %]_temperature')|round(1) }} °C -
          {{ states('sensor.[% item %]_humidity')|round(0) }} %
        icon_tap_action:
          action: more-info
          entity: sensor.[% item %]_humidity
        [% END %]
      [% END %]

      - [% WRAPPER tile_card.tt
                   entity  = "sensor.growatt_temperature"
                   name    = "Omvormer"
                   %]
        [% END %]

