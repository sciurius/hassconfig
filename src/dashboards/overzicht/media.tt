# Dashboard: Overzicht -- Media       -*- hass -*-
# WARNING: This is a generated file -- DO NOT EDIT

[% INCLUDE section.tt
       name     = "Media"
       icon     = "disc-player"
       badges   = []
       color    = "lavender"
       navigate = "/lovelace-overzicht/media" %]

      - type: custom:mushroom-template-card
        entity: sensor.mass_total_albums
        primary: "{{ states(entity) }} albums"
        secondary: "{{ states('sensor.mass_total_artists') }} artists"
        icon: mdi:folder-play-outline
        color: var(--state-icon-color)
        icon_tap_action:
          action: url
          url_path: https://mass.squirrel.nl/#/albums
        
      - type: custom:mushroom-template-card
        entity: sensor.allmusic_total_albums
        primary: "{{ states(entity) }} albums"
        secondary: "{{ states('sensor.allmusic_total_artists') }} artists"
        icon: mdi:play-network-outline
        color: var(--state-icon-color)
        icon_tap_action:
          action: url
          url_path: https://lms.squirrel.nl/default
        
      - type: custom:mushroom-template-card
        entity: sensor.kpn_itv_recordings_used
        primary: >-
          Video
          {% set h = (( states(entity)|int ) / 60 ) | int %}
          {% set m = (( states(entity)|int ) % 60 ) %}
          {% if h > 0 %}{{ h }}h {% endif %}
          {% if m > 0 %}{{ m }}min {% endif %}
        secondary: >-
          {{ ( ( states('sensor.kpn_itv_recordings_used')|int * 100 )
               / states('sensor.kpn_itv_recordings_total')|int )|int
          }}% (KPN)
        icon: mdi:file-video-outline
        color: var(--state-icon-color)
        icon_tap_action:
          action: url
          url_path: https://tv.kpn.com/opgeslagen
