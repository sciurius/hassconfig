# Dashboard: Overzicht -- Laders       -*- hass -*-
# WARNING: This is a generated file -- DO NOT EDIT

[% INCLUDE section.tt
       name   = "Laders"
       icon   = "power-plug-battery"
       badges = [] %]

[%# Sensor controlled -%]
[% BLOCK batt -%]
[% WRAPPER tile_card.tt
           entity  = "sensor." _ sensor
           name    = name
           visible = "available"
           %]
        [% END %]
[% END -%]

      - [% INCLUDE batt  name = "Largo"  sensor = "sm_a366b_battery_level" %]
      - [% INCLUDE batt  name = "GlaxS4" sensor = "sm_t830_battery_level" %]
      - [% INCLUDE batt  name = "GlaxS7" sensor = "sm_t733_battery_level" %]
      - [% INCLUDE batt  name = "Joni"   sensor = "joni_battery_level" %]
      - [% INCLUDE batt  name = "Zenny"  sensor = "zenny_battery_level" %]

      - [% WRAPPER mt_card.tt
                   entity  = "sensor.systems_smotty_battery"
                   name    = "Smotty"
                   visible = "available"
                   %]
        color: >-
          {% if   states(entity)|int >= 4 %} [% dash.col.green %]
          {% elif states(entity)|int >= 3 %} orange
          {% else                         %} red
          {% endif %}
        icon: >-
          {% set charging = "-charging" if is_state('binary_sensor.systems_smotty_plugged','on') else "" %}
          {% set lvl = ((states(entity)|int) / 10 ) | int %}
          mdi:battery{{ charging }}-{{ lvl }}0
        secondary: "{{ states(entity) }} %"
        [% END %]

      - [% INCLUDE batt  name = "TZ200"  sensor = "battery_tz200" %]
      - [% INCLUDE batt  name = "Irmby"  sensor = "irmby_battery_level" %]

      - [% WRAPPER mt_card.tt
                   entity  = "sensor.ups_pico_battery_level"
                   name    = "UPS Srv1"
                   visible = "available"
                   %]
        color: >-
          {% if   states(entity)|int >= 4 %} [% dash.col.green %]
          {% elif states(entity)|int >= 3 %} orange
          {% else                         %} red
          {% endif %}
        icon: >-
          {% set charging = "-charging" if is_state('sensor.ups_pico_charger','Connected') else "" %}
          {% if   states(entity)|int >= 5 %} mdi:battery{{ charging }}-high
          {% elif states(entity)|int >= 4 %} mdi:battery{{ charging }}-medium
          {% elif states(entity)|int >= 3 %} mdi:battery{{ charging }}-low
          {% else                         %} mdi:battery{{ charging }}-outline
          {% endif %}
        secondary: "{{ states(entity) }} V"
        [% END %]

      - [% WRAPPER mt_card.tt
                   entity  = "binary_sensor.bresser51_battery"
                   name    = "Weerstation"
                   visible = "available"
                   %]
        color: >-
          {% if   is_state(entity,'off') %} [% dash.col.green %]
          {% else                        %} red
          {% endif %}
        icon: >-
          {% if   is_state(entity,'off') %} mdi:battery-medium
          {% else                        %} mdi:battery-alert-variant-outline
          {% endif %}
        secondary: >-
          {{ "Ok" if is_state(entity,'off') else "Empty" }}
        [% END %]

      - [% WRAPPER mt_card.tt
                   entity  = "sensor.carolan_fuel_level"
                   name    = "Carolan"
                   icon    = "mdi:gas-station"
                   visible = "available"
                   %]
        color: >-
          {% if   states(entity)|int >= 30 %} [% dash.col.green %]
          {% elif states(entity)|int >= 15 %} orange
          {% else                          %} red
          {% endif %}
        secondary: >-
          {{ states(entity)|int }} %
        [% END %]

      - [% INCLUDE timed.tt name = "Scoot"  switch = "scootlader" %]
