# Dashboard: Overzicht -- Weerstation       -*- hass -*-
# WARNING: This is a generated file -- DO NOT EDIT

[% device              = "bresser51";
   wind_beaufort       = "sensor." _ device _ "_wind_beaufort";
   wind_speed          = "sensor." _ device _ "_wind_speed";
   wind_direction      = "sensor." _ device _ "_wind_direction_sector";
   wind_direction_name = "sensor." _ device _ "_wind_direction_name";
-%]

[% INCLUDE section.tt
       name     = "Weerstation"
       icon     = "countertop"
       entity   = device
       navigate = "/lovelace-" _ device %]

      - [% WRAPPER mt_card.tt
                   entity  = "sensor.compass"
                   %]
        primary: >-
          {% if states('[% wind_beaufort %]')|int > 0 %}
          {{ states('[% wind_direction_name %]') | replace('S','Z') | replace('E','O') }}
          {% else %} Wind {% endif %}
        picture: >-
          {% if states('[% wind_beaufort %]')|int > 0 %}
          /local/compass/arrow-{{ states('[% wind_direction %]') }}.svg
          {% else %} /local/compass/arrow-none.svg {% endif %}
        secondary: >-
          {% if states('[% wind_beaufort %]')|int > 0 %}
          {{ states('[% wind_beaufort %]') }} Bft,
          {{ states('[% wind_speed %]') }} m/s
          {% else %} Calm {% endif %}
        [% END %]

      - [% WRAPPER tile_card.tt
                   entity  = "sensor.knmi_pressure"
                   name    = "Luchtdruk"
                   %]
        [% END %]

      - [% WRAPPER mt_card.tt
                   entity  = "sensor.bresser51_wind_chill"
                   name    = "Voelt als"
                   %]
        icon: >-
          {% if states('sensor.bresser51_wind_chill')|float < 0 %}
          mdi:thermometer-low
          {% else %}
          mdi:thermometer
          {% endif %}
        color: var(--state-icon-color)
        secondary: "{{ states('sensor.bresser51_wind_chill') }} °C"
        [% END %]

[% FOR i IN [ 168, 24, 1 ] %]
      - [% WRAPPER mt_card.tt
                   entity  = "sensor.bresser51_rain_" _ i _ "h"
                   name    = i _ " uur"
                   icon    = "mdi:weather-rainy"
                   visible = ">0"
                   %]
        color: var(--state-icon-color)
        secondary: "{{ states('sensor.bresser51_rain_[% i %]h') }} mm"
        tap_action:
          action: more-info
          entity: sensor.bresser51_rain_[% i %]h
        [% END %]
[% END %]
