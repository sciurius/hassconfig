# Dashboard: Overzicht -- Alert Ticker       -*- hass -*-
# WARNING: This is a generated file -- DO NOT EDIT

type: custom:alert-ticker-card
cycle_interval: 5
show_when_clear: false
clear_message: ''
clear_theme: success
cycle_animation: fold
overlay_mode: true
overlay_position: top
overlay_duration: 0

alerts:

  - entity: sensor.boiler_system_pressure
    message: >-
      Boiler System pressure {{
      states('sensor.boiler_system_pressure') }} bar
    priority: 1
    theme: emergency
    icon: ''
    name: CV Pressure Low
    conditions_logic: or
    conditions:
      - entity: sensor.boiler_system_pressure
        operator: <
        state: '1.0'
      - entity: input_boolean.testing_alerts
        state: "on"

  - entity: sensor.phoenix_nvme0_temperature_updated
    message: "Phoenix offline"
    conditions_logic: or
    conditions:
      - entity: sensor.phoenix_nvme0_temperature_updated
        operator: older
        state: "90"
      - entity: input_boolean.testing_alerts
        state: "on"

  - entity: sensor.systems_srv1_timestamp
    message: "SRV1 offline"
    conditions_logic: or
    conditions:
      - entity: sensor.systems_srv1_timestamp
        operator: older
        state: "120"
      - entity: input_boolean.testing_alerts
        state: "on"

  - entity: sensor.systems_srv4_timestamp
    message: "SRV4 offline"
    conditions_logic: or
    conditions:
      - entity: sensor.systems_srv4_timestamp
        operator: older
        state: "120"
      - entity: input_boolean.testing_alerts
        state: "on"

  - entity: binary_sensor.carolan_vehicle_health
    message: "Carolan health problem"
    conditions_logic: or
    conditions:
      - entity: binary_sensor.carolan_vehicle_health
        operator: "="
        state: "on"
      - entity: input_boolean.testing_alerts
        state: "on"

  - entity: sensor.carolan_warning_lights
    message: "Carolan warning lights"
    conditions_logic: or
    conditions:
      - entity: sensor.carolan_warning_lights
        operator: ">"
        state: 0
      - entity: input_boolean.testing_alerts
        state: "on"

  - entity: binary_sensor.phoenix_database_error
    message: "Postgres Database Problem"
    theme: emergency
    icon: ''
    conditions_logic: or
    conditions:
      - entity: binary_sensor.phoenix_database_error
        operator: "="
        state: "on"
      - entity: input_boolean.testing_alerts
        state: "on"

  - entity: sensor.letsencrypt_cert_days
    message: >-
      LetsEncrypt Cert expires in
      {{ states('sensor.letsencrypt_cert_days') }} days
    conditions_logic: or
    conditions:
      - entity: sensor.letsencrypt_cert_days
        operator: "<"
        state: 14
      - entity: input_boolean.testing_alerts
        state: "on"

