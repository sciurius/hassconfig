# Dashboard: Overzicht -- Hal       -*- hass -*-
# WARNING: This is a generated file -- DO NOT EDIT
[% PROCESS v_anchors.tt -%]

[% INCLUDE section.tt
       name     = "Joan"
       icon     = "radar"
       columns  = 1
       badges   = [ "battery" ]
       battery_entity = "sensor.tracker_joan_battery"
       navigate = "/lovelace-overzicht/trackerjoan" %]

      - type: custom:mushroom-template-card
        icon: mdi:radar
        entity: device_tracker.tracker_joan
        primary: Joan
        secondary: >-
          {% if state_attr('device_tracker.tracker_joan', 'speed' )|float > 0 %}
          {{ state_attr('device_tracker.tracker_joan', 'speed' )|float }} km/h
          {% else %}{{ states('device_tracker.tracker_joan') }}
          {% endif %}
        visibility:
          - entity: device_tracker.tracker_joan
            <<: *v_available

      - type: map
        entities:
          - entity: device_tracker.tracker_joan
            label_mode: name
            name: Joan
        hours_to_show: 1
        theme_mode: auto
