# Dashboard: Overzicht -- Kantoor       -*- hass -*-
# WARNING: This is a generated file -- DO NOT EDIT

[% INCLUDE section.tt
       name = "Kantoor"
       icon = "account-network"
       navigate = "/lovelace-overzicht/kantoor" %]

      - type: tile
        entity: binary_sensor.home_assistant_website_update_available
        name: HASS Software
        visibility:
          - entity: binary_sensor.home_assistant_website_update_available
            condition: state
            state: "on"
        tap_action:
          action: url,
          url_path: "{{ state_attr('sensor.home_assistant_website','release_notes') }}"
        card_mod:
          style:
            ha-tile-info$: |
              .secondary {
                visibility: hidden;
                display: inline;
              }
              .secondary:before {
                visibility: visible;
                content: 'Update available';
              }

      - type: custom:mushroom-template-card
        entity: sensor.systems_wan_uptime
        primary: WAN Up
        icon: mdi:wan
        color: |
          {{ 'red' if states('sensor.systems_wan_uptime')|int<86400
             else 'var(--state-icon-color)' }}
        secondary: |
          {% from 'relative_time_plus.jinja' import relative_time_plus %}
          {{ relative_time_plus(states('sensor.systems_wan_uptime'),parts=2,abbr=true,compare_date=0)|replace(" and ",", ")}}

      - type: tile
        entity: sensor.home_assistant_website
        name: Hass Software

      - [% WRAPPER tile_card.tt type="mt"
                   entity = "sensor.phoenix_linux_disk_usage_volume"
                   name = "Phoenix"
                   icon = "mdi:harddisk"
                   visible = "available"
                   %]
        secondary: "{{ state_attr('sensor.phoenix_linux_disk_usage_volume','percent') }} %"
        color: |
          {% set inuse = state_attr('sensor.phoenix_linux_disk_usage_volume','percent') |int %}
          {% if inuse >= 90 %} red
          {% elif inuse >= 80 %} orange
          {% else %} var(--state-icon-color) {% endif %}
        [% END %]

      - name: NAS1
        entity: sensor.nas1_volume_1_volume_used
[% IF 1 %]
        type: tile
[% ELSE %]
        type: custom:horizontal-gauge-card
        min: 0
        max: 100
        needle: true
        show_segment_labels: false
        segment_label_position: below
        value_label_position: above
        segments:
          - value: 80
            color: var(--state-icon-color)
            label: Low
          - value: 90
            color: var(--warning-color)
            label: Med
          - value: 100
            color: var(--error-color)
            label: High
[% END %]

      - type: tile
        entity: sensor.nextcloud_free_space
        name: NextCloud
        icon: mdi:cloud
        unit: "GiB free"

      - entity: sensor.www_disk_inuse
        icon: mdi:cloud
[% IF 1 %]
        type: custom:mushroom-template-card
        primary: WWW Server
        secondary: "{{ states('sensor.www_disk_inuse') }} %"
        color: |
          {% if states('sensor.www_disk_inuse')|int >= 98 %} red
          {% elif states('sensor.www_disk_inuse')|int >= 96 %} orange
          {% else %} var(--state-icon-color) {% endif %}
[% ELSE %]    
        type: custom:horizontal-gauge-card
        name: WWW Server
        min: 0
        max: 100
        needle: true
        show_segment_labels: false
        segment_label_position: below
        value_label_position: above
        segments:
          - value: 96
            color: var(--state-icon-color)
            label: Low
          - value: 98
            color: var(--warning-color)
            label: Med
          - value: 100
            color: var(--error-color)
            label: High
[% END %]

      - type: tile
        entity: switch.radiatorfans
        name: Radiator fans
        icon: mdi:fan
        visibility:
          - entity: timer.radiatorfans
            condition: state
            state_not: active

      - type: tile
        entity: timer.radiatorfans
        name: Radiator fans
        icon: mdi:fan
        visibility:
          - entity: timer.radiatorfans
            <<: *v_active

      - [% INCLUDE timed.tt
           name   = "Voetkacheltje"
           switch = "kantoorkacheltje"
           icon   = "heat-wave" %]

      - [% INCLUDE switching_meter.tt
           name = "Exs Kachel1" sensor = "kantoorxkacheltje"
           icon = "heat-wave" %]

      [% PROCESS ir_action.tt; remote = "kantoor" -%]
      - type: custom:mushroom-template-card
        entity: switch.kantoor_airco
        icon: mdi:air-conditioner
        primary: AirCo
        secondary: "{{ states('sensor.kantoor_airco_energy_today')|round(2) }} kWh"
        visibility:
          - entity: switch.kantoor_airco
            <<: *v_available
        color: "var(--state-{{ '' if (states('sensor.kantoor_airco_energy_power')|int(0)) > 2 else 'in'}}active-color)"
        icon_tap_action: [% ir_perform(remote,"airco","power") %]
        tap_action:
          action: more-info
          entity: sensor.kantoor_airco_energy_today

      - type: tile
        entity: switch.psw03
        name: Printer
        icon: mdi:printer

      - type: tile
        entity: media_player.phoenix_squirrel_nl
        name: Phoenix
        visibility:
          - condition: or
            conditions:
              - condition: state
                state: playing
              - condition: state
                state: paused
      
      - type: tile
        entity: media_player.sleepy_ma
        name: Sleepy (MA)
        visibility:
          - condition: or
            conditions:
              - condition: state
                state: playing
              - condition: state
                state: paused
      
      - type: tile
        entity: media_player.sleepy_lms
        name: Sleepy (LMS)
        visibility:
          - condition: or
            conditions:
              - condition: state
                state: playing
              - condition: state
                state: paused
      
      - type: custom:mushroom-template-card
        entity: light.bulb01
        primary: Media Center actief
        secondary: "{{ states('sensor.mc_state') }}"
        icon: mdi:television
        color: "rgb({{ state_attr('light.bulb01','rgb_color')|join(',') }})"
        visibility:
          - condition: or
            conditions:
              - entity: light.bulb01
                condition: state
                state: "on"
              - entity: switch.slaapkamer_media_center
                condition: state
                state: "on"
                
