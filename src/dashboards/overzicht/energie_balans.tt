# Dashboard: Overzicht -- Energie       -*- hass -*-
# WARNING: This is a generated file -- DO NOT EDIT

[% PROCESS v_anchors.tt -%]
[% PROCESS colours.tt -%]
[%-
# Sensor mapping.
extra1 = "kantoorxkacheltje";
extra2 = "huiskamerkacheltje";
boiler = "exsboiler"
-%]

[% INCLUDE section.tt
   name     = "Energie Overschot"
   icon     = "lightning-bolt"
   badges   = [ "overschot", "auto" ]
   overschot_entity = "sensor.energie_overschot"
   auto_entity = "automation.energiebalans"
   navigate = "/lovelace-overzicht/energie"
   %]

      - [% WRAPPER mt_card.tt
                   icon    = "mdi:radiator"
                   name    = "Exs Kachel1"
                   entity  = "switch." _ extra1
                   visible = "available"
                   %]
        color: |
          {% if is_state('input_boolean.[% extra1 %]_enabled','on') %}
            {% if is_state('switch.[% extra1 %]','on') %}
              [% dash.col.active %]
            {% else %}
              [% dash.col.default %]
            {% endif %}
          {% else %}
            [% dash.col.inactive %]
          {% endif %}
        secondary: |
          {{ states('sensor.[% extra1 %]_energy_today') }} kWh
        tap_action:
          action: more-info
          entity: sensor.[% extra1 %]_energy_today
        hold_action:
          action: perform-action
          perform_action: input_boolean.toggle
          target:
            entity_id: input_boolean.[% extra1 %]_enabled
        icon_hold_action:
          action: perform-action
          perform_action: input_boolean.toggle
          target:
            entity_id: input_boolean.[% extra1 %]_enabled
        [% END %]

      - [% WRAPPER mt_card.tt
                   icon    = "mdi:radiator"
                   name    = "Exs Kachel2"
                   entity  = "switch." _ extra2
                   visible = "available"
                   %]
        color: |
          {% if is_state('input_boolean.[% extra2 %]_enabled','on') %}
            {% if is_state('switch.[% extra2 %]','on') %}
              [% dash.col.active %]
            {% else %}
              [% dash.col.default %]
            {% endif %}
          {% else %}
            [% dash.col.inactive %]
          {% endif %}
        secondary: |
          {{ states('sensor.[% extra2 %]_energy_today') }} kWh
        tap_action:
          action: more-info
          entity: sensor.[% extra2 %]_energy_today
        hold_action:
          action: perform-action
          perform_action: input_boolean.toggle
          target:
            entity_id: input_boolean.[% extra2 %]_enabled
        icon_hold_action:
          action: perform-action
          perform_action: input_boolean.toggle
          target:
            entity_id: input_boolean.[% extra2 %]_enabled
        [% END %]

      - [% WRAPPER mt_card.tt
                   icon    = "mdi:water-boiler"
                   name    = "Exs Boiler"
                   entity  = "switch." _ boiler
                   visible = "available"
                   %]
        color: |
          {% if is_state('input_boolean.[% boiler %]_enabled','on') %}
            {% if is_state('input_boolean.[% boiler %]_hot','on') %}
              [% dash.col.green %]
            {% else %}
              {% if is_state('switch.[% boiler %]','on') %}
                [% dash.col.active %]
              {% else %}
                [% dash.col.default %]
              {% endif %}
            {% endif %}
          {% else %}
            [% dash.col.inactive %]
          {% endif %}
        secondary: |
          {{ states('sensor.[% boiler %]_energy_today') }} kWh
        tap_action:
          action: more-info
          entity: sensor.[% boiler %]_energy_today
        hold_action:
          action: perform-action
          perform_action: input_boolean.toggle
          target:
            entity_id: input_boolean.[% boiler %]_enabled
        icon_hold_action:
          action: perform-action
          perform_action: input_boolean.toggle
          target:
            entity_id: input_boolean.[% boiler %]_enabled
        [% END %]        
