# Dashboard: Overzicht -- Hal       -*- hass -*-
# WARNING: This is a generated file -- DO NOT EDIT

[% INCLUDE section.tt
       name     = "Databases"
       icon     = "database"
       navigate = "/lovelace-overzicht/computers"
       badges   = []
       color    = "lavender"
       %]

[% FOR db IN [ 'Phoenix', 'MAss', 'Srv4', 'Srv5' ] %]
      - [% WRAPPER mt_card.tt
                   entity  = "sensor." _ db.lower _ "_databases_size"
                   name    = db
                   %]
        secondary: "{{ (states(entity)|int /1024 /1024) |int }} MiB"
        icon: mdi:database-outline
        color: var(--state-icon-color)
        [% END %]
[% END %]

[% FOR db IN [ 'Cloud' ] %]
      - [% WRAPPER mt_card.tt
                   entity  = "sensor." _ db.lower _ "_squirrel_nl_databse_size"
                   name    = db
                   %]
        secondary: "{{ states(entity)|int }} MiB"
        icon: mdi:database-outline
        color: var(--state-icon-color)
        [% END %]
[% END %]
