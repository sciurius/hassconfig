# Dashboard: Tracker Joan --        -*- hass -*-
# WARNING: This is a generated file -- DO NOT EDIT

title: Trackers
views:

  - type: sections
    title: Tracker Johan
    path: trackerjohan
    sections:

      - type: grid
        column_span: 3
        cards:

          - type: custom:map-card
            zoom: 15
            focus_entity: device_tracker.sm_a366b
            # refocus makes the map zoom in max.
            # focus_follow: refocus
            entities:
              - entity: device_tracker.sm_a366b
                display: icon
                icon: mdi:account-circle
                color: red
                size: 24
                z_index_offset: 20
                history_start: 12 hours ago
                circle:
                  source: config
                  color: purple
                  radius: 1
              - entity: zone.home
                z_index_offset: 0
                size: 24
            theme_mode: auto
            # Fix OSM Error 403r.
            tile_layer_options:
              referrerPolicy: "origin-when-cross-origin" 
            grid_options:
              columns: full
              rows: 8

  - type: sections
    title: Tracker Carolan
    path: trackercarolan
    sections:

      - type: grid
        column_span: 3
        cards:
          - type: custom:map-card
            zoom: 15
            focus_entity: device_tracker.carolan_parking_location
            # refocus makes the map zoom in max.
            # focus_follow: refocus
            entities:
              - entity: device_tracker.carolan_parking_location
                display: icon
                icon: mdi:car
                color: red
                size: 24
                z_index_offset: 20
                history_start: 12 hours ago
                circle:
                  source: config
                  color: purple
                  radius: 1
              - entity: zone.home
                z_index_offset: 0
                size: 24
            theme_mode: auto
            # Fix OSM Error 403r.
            tile_layer_options:
              referrerPolicy: "origin-when-cross-origin" 
            grid_options:
              columns: full
              rows: 8

      - type: grid
        column_span: 3
        columns: 6
        square: false
        cards:

          - [% WRAPPER mt_card.tt
                       entity  = "device_tracker.carolan_parking_location"
                       name    = "Locatie"
                       visible = "available"
                       %]
            icon: >-
              {% if is_state(entity,'home') %}
              mdi:home
              {% else %}
              mdi:car-hatchback
              {% endif %}
            color: >-
              {% if is_state(entity,'home') %}
              [% dash.col.green %]
              {% else %}
              [% dash.col.default %]
              {% endif %}
            secondary: >-
              {% if is_state(entity,'home') %}
              Thuis
              {% else %}
              {{ states(entity) }}
              {% endif %}
            tap_action:
              action: navigate
              navigation_path: /lovelace-trackers/trackercarolan
            [% END %]

          - [% WRAPPER mt_card.tt
                       entity  = "sensor.carolan_fuel_level"
                       name    = "Brandstof"
                       icon    = "mdi:gas-station"
                       visible = "available"
                       %]
            color: >-
              {% if   states(entity)|int >= 30 %} [% dash.col.green %]
              {% elif states(entity)|int >= 15 %} orange
              {% else                         %} red
              {% endif %}
            secondary: >-
              {{ states(entity)|int }}%
              ({{ states('sensor.carolan_fuel_range')|int }} km)
            [% END %]
              
          - [% WRAPPER tile_card.tt
                       entity  = "sensor.carolan_current_day_statistics"
                       name    = "Dag"
                       icon    = "mdi:map-marker-distance"
                       visible = "available"
                       %]
            [% END %]

          - [% WRAPPER tile_card.tt
                       entity  = "sensor.carolan_current_week_statistics"
                       name    = "Week"
                       icon    = "mdi:map-marker-distance"
                       visible = "available"
                       %]
            [% END %]

          - [% WRAPPER tile_card.tt
                       entity  = "sensor.carolan_current_month_statistics"
                       name    = "Maand"
                       icon    = "mdi:map-marker-distance"
                       visible = "available"
                       %]
            [% END %]

          - [% WRAPPER tile_card.tt
                       entity  = "sensor.carolan_current_year_statistics"
                       name    = "Jaar"
                       icon    = "mdi:map-marker-distance"
                       visible = "available"
                       %]
            [% END %]
