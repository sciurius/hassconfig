# Dashboard: slaapkamerremote -- Slaapkamer       -*- hass -*-
# WARNING: This is a generated file -- DO NOT EDIT

[%- PROCESS yaml.tt -%]
[%- PROCESS ir_action.tt; remote = "slaapkamer" -%]
[%- INCLUDE kiosk.tt %]

views:
  - title: Afstandsbediening
    type: sections
    sections:
      - type: grid
        cards:

        #### Activities panel. Always present.

[%- MACRO activity_button(device) BLOCK -%]
    type: custom:button-card
    icon: mdi:[% icon %]
    styles:
      card:
        - background: '[[[ if (entity.state.toLowerCase() == "[% device.lower() %]") return "lime"; else return "yellow" ]]]'
      icon:
        - color: red
          width: 50%
    entity: select.slaapkamer_media_center
    show_name: false
    tap_action:
      action: perform-action
      perform_action: script.activity_[% device %]
    hold_action:
      action: perform-action
      perform_action: script.activity_[% device %]
    show_icon: true
    section_mode: true
    grid_options:
      rows: auto
      columns: 4
[%- END %]

          - [% yaml(activity_button( "off",        icon = "power" ), 12) %]
            hold_action:
              action: perform-action
              perform_action: script.activity_reset
          - [% yaml(activity_button( "tv",         icon = "television-classic" ), 12) %]
          - [% yaml(activity_button( "video",      icon = "movie-open-outline" ), 12) %]

      #### Power panel. Always present.

[%- MACRO power_button(device) BLOCK -%]
    type: custom:button-card
    styles:
      card:
        - color: green
        - background-color: lightyellow
      icon:
        - color: green
        - width: 50%
    name: [% device.upper() %]
    show_name: true
    tap_action:
      [% ir_perform(remote,device,"power") %]
    icon: mdi:switch
    show_icon: false
    show_label: true
    entity: input_boolean.slaapkamer_[% device %]
    label: >-
      [[[ if (entity.state==="on") return "UIT/AAN"; else return "AAN/UIT" ]]]
    section_mode: true
    grid_options:
      rows: auto
      columns: 4
[%- END %]

          - [% yaml(power_button("tv"),    12) %]
          - [% yaml(power_button("audio"), 12) %]
          - [% yaml(power_button("stb"),   12) %]

      #### Volume

[%- MACRO audio_button(op) BLOCK -%]
    type: custom:button-card
    color_type: card
    color: lightblue
    styles:
      icon:
        - color: black
          width: 50%
    show_name: false
    tap_action:
      [% ir_perform(remote,"audio",op) %]
    hold_action:
      [% ir_perform(remote,"audio",op) %]
    icon: mdi:[% icon %]
    show_icon: true
    section_mode: true
    grid_options:
      rows: auto
      columns: 4
[%- END %]


      #### TV: Volume/Play/Pause/Subtitles/Undo

[%- MACRO tv_button(dev,op) BLOCK -%]
    type: custom:button-card
    color_type: card
    color: lightgreen
    styles:
      icon:
        - color: black
          width: 50%
    show_name: false
    tap_action:
      [% IF action %]
      action: perform-action
      perform_action: [% action;
      ELSE;
      ir_perform(remote,dev,op);
      END %]
    hold_action:
      [% IF action %]
      action: perform-action
      perform_action: [% action;
      ELSE;
      ir_perform(remote,dev,op);
      END %]
    icon: mdi:[% icon %]
    show_icon: true
    section_mode: true
    grid_options:
      rows: auto
      columns: 4
[%- END %]

          - [% yaml(tv_button( "stb", "channel_up",
                               icon = "plus-thick"), 12) %]
            name: Zender
            show_name: true
            layout: icon_name

          - [% yaml(tv_button( "stb", "subtitles", icon = "subtitles-outline",
                               action = "script.subtitles_tv" ), 12) %]
            entity: input_boolean.subtitles
            state:
              - value: 'on'
                icon: mdi:subtitles
              - value: 'off'
                icon: mdi:subtitles-outline
                color: lightgreen

          - [% yaml(audio_button("volume_up", icon = "volume-plus"), 12) %]

          - [% yaml(tv_button( "stb", "channel_down",
                               icon = "minus-thick"), 12) %]
            name: Zender
            show_name: true
            layout: icon_name

          - [% yaml(audio_button("volume_mute", icon = "volume-mute"), 12) %]

          - [% yaml(audio_button("volume_down", icon = "volume-minus"), 12) %]

      #### Video: Play/Pause/Stop/Back

[%- MACRO video_button(op) BLOCK -%]
    type: custom:button-card
    icon: mdi:[% icon %]
    show_icon: true
    color_type: card
    color: pink
    styles:
      icon:
        - color: black
        - width: 50%
    show_name: false
[%- IF op.search('\.') %]
    tap_action:
      action: perform-action
      perform_action: rest_command.kodicmd
      data:
        cmd: [% op %]
    hold_action:
      action: perform-action
      perform_action: rest_command.kodicmd
      data:
        cmd: [% op %]
[%- ELSE %]
    tap_action:
      action: perform-action
      perform_action: media_player.media_[% op %]
      data:
        entity_id: media_player.osmc
    hold_action:
      action: perform-action
      perform_action: media_player.media_[% op %]
      data:
        entity_id: media_player.osmc
[%- END %]
    section_mode: true
    grid_options:
      rows: auto
      columns: 4
[%- END %]

          - type: custom:state-switch
            entity: select.slaapkamer_media_center
            default: TV
            states:
              TV:
                [% yaml(tv_button( "stb", "play_pause", icon = "play-pause"), 16) %]
              Video:
                [% yaml(video_button( "play", icon = "play"), 16) %]
            grid_options:
              rows: auto
              columns: 4

          - [% yaml(video_button("Input.Up",     icon = "arrow-up-bold"), 12) %]

          - [% yaml(video_button("stop",         icon = "stop"), 12) %]

          - [% yaml(video_button("Input.Left",   icon = "arrow-left-bold"), 12) %]
          - type: custom:state-switch
            entity: select.slaapkamer_media_center
            default: TV
            states:
              TV:
                [% yaml(tv_button( "stb", "ok", icon = "checkbox-marked-circle-outline"), 16) %]
              Video:
                [% yaml(video_button("Input.Select", icon = "checkbox-outline"),16) %]
            grid_options:
              rows: auto
              columns: 4

          - [% yaml(video_button("Input.Right",  icon = "arrow-right-bold"), 12) %]

          - type: custom:state-switch
            entity: select.slaapkamer_media_center
            default: TV
            states:
              TV:
                [% yaml(tv_button( "stb", "play_pause", icon = "play-pause"), 16) %]
              Video:
                [% yaml(video_button( "pause", icon = "pause"), 16) %]
            grid_options:
              rows: auto
              columns: 4

          - [% yaml(video_button("Input.Down",   icon = "arrow-down-bold"), 12) %]

          - [% yaml(video_button("Input.Back",   icon = "arrow-u-left-top"), 12) %]
