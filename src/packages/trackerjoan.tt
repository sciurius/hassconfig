[% PROCESS notify_tts.tt -%]

input_boolean:
  joan_is_moving:
    name: Joan is moving
    icon: mdi:bike

automation:

  - id: tracker_joan_getting_near
    alias: Joan getting near
    description: "Tracker Joan enters Home zone"
    mode: single

    triggers:
      - trigger: zone
        entity_id: device_tracker.tracker_joan
        zone: zone.home
        event: enter

    conditions:
      - condition: state
        entity_id: input_boolean.joan_is_moving
        state: "on"

    actions:
      - [% notify_tts( "Joan is getting near" ) %]
      - action: input_boolean.turn_off
        target:
          entity_id: input_boolean.joan_is_moving

  - id: tracker_joan_starts_moving
    alias: Joan starts moving
    description: "Joan starts moving"
    mode: single

    triggers:
      - trigger: numeric_state
        entity_id:
          - device_tracker.tracker_joan
        for:
          hours: 0
          minutes: 2
          seconds: 0
        above: 1
        attribute: speed
    actions:
      - action: input_boolean.turn_on
        target:
          entity_id: input_boolean.joan_is_moving


  - id: tracker_joan_stops_moving
    alias: Joan stops moving
    description: "Joan stops moving"
    mode: single

    triggers:
      - trigger: numeric_state
        entity_id:
          - device_tracker.tracker_joan
        for: "00:03:00"
        below: 1
        attribute: speed

    conditions:
      - condition: state
        entity_id: input_boolean.joan_is_moving
        state: "on"
      - condition: zone.not_in_zone
        target:
          entity_id: device_tracker.tracker_joan
        options:
          zone: zone.home

    actions:
      - [% notify_tts( "Joan stopped moving" ) %]
      - action: input_boolean.turn_off
        target:
          entity_id: input_boolean.joan_is_moving
