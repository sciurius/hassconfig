# Energie                      -*- hass -*-
# WARNING: This is a generated file -- DO NOT EDIT

[%-

# Load of heater, in Watts.
load_heater1 = 900;
load_heater2 = 900;
load_boiler = 2300;
# Floor space, in Watts.
load_floor = 200

# Sensor mapping.
heater1 = "kantoorxkacheltje";
heater2 = "huiskamerkacheltje";
boiler = "exsboiler";

-%]

automation:

  - id: Automation__EnergieBalans
    alias: EnergieBalans
    description: "Schakel belastingen aan bij energieoverschot"
    mode: single

    # Based on a suggestion from TheFes.
    triggers:

      - id: all_off
        trigger: numeric_state
        entity_id: sensor.energie_overschot
        below: [% load_heater1 %]
        for: "00:01:00"

      - id: heater1_on
        trigger: numeric_state
        entity_id: sensor.energie_overschot
        above: [% load_heater1 %]
        below: [% load_heater2 %]
        for: "00:01:00"

      - id: heater2_on
        trigger: numeric_state
        entity_id: sensor.energie_overschot
        above: [% load_heater2 %]
        below: [% load_heater2 + load_heater1 %]
        for: "00:01:00"

      - id: all_on
        trigger: numeric_state
        entity_id: sensor.energie_overschot
        above: [% load_heater2 + load_heater1 %]
        for: "00:01:00"

    actions:

      - action: notify.info
        data:
          message: >-
            Trigger {{ trigger.id }},
            overschot {{ states('sensor.energie_overschot') }} W,
            heater1 {{ states('switch.[% heater1 %]') }}
            ({{ states('sensor.[% heater1 %]_energy_power')|float }}),
            heater2 {{ states('switch.[% heater2 %]') }}
            ({{ states('sensor.[% heater2 %]_energy_power')|float }}).

      - choose:

        # Insufficient energy, switch all off.
        - conditions:
           - condition: trigger
             id: all_off
          sequence:
          - action: switch.turn_off
            target:
              entity_id:
                - switch.[% heater1 %]
                - switch.[% heater2 %]

        # Sufficient energy for heater1, but not for heater2.
        - conditions:
           - condition: trigger
             id: heater1_on
           - condition: state
             entity_id: input_boolean.[% heater1 %]_enabled
             state: "on"
          sequence:
          - action: switch.turn_on
            target:
              entity_id:
                - switch.[% heater1 %]
          - action: switch.turn_off
            target:
              entity_id:
                - switch.[% heater2 %]

        # Sufficient energy for heater2, but not for both.
        - conditions:
            - condition: trigger
              id: heater2_on
          sequence:
            - if:
                - condition: state
                  entity_id: input_boolean.[% heater2 %]_enabled
                  state: "on"
              then:
                - action: switch.turn_on
                  target:
                    entity_id: switch.[% heater2 %]
                - action: switch.turn_off
                  target:
                    entity_id: switch.[% heater1 %]
              else:
                - if:
                    - condition: state
                      entity_id: input_boolean.[% heater1 %]_enabled
                      state: "on"
                  then:
                    - action: switch.turn_on
                      target:
                        entity_id: switch.[% heater1 %]

        # Sufficient energy for both.
        - conditions:
            - condition: trigger
              id: all_on
          sequence:
            - if:
                - condition: state
                  entity_id: input_boolean.[% heater2 %]_enabled
                  state: "on"
              then:
                - action: switch.turn_on
                  target:
                    entity_id: switch.[% heater2 %]
            - if:
                - condition: state
                  entity_id: input_boolean.[% heater1 %]_enabled
                  state: "on"
              then:
                - action: switch.turn_on
                  target:
                    entity_id: switch.[% heater1 %]

  # If the boiler is completely heated up, register it.
  - id: Automation__ExsBoiler_Hot
    alias: ExsBoiler Hot
    initial_state: false
    mode: single
    triggers:
      - trigger: numeric_state
        entity_id: sensor.exsboiler_energy_power
        below: 10
    conditions:
      - condition: state
        entity_id: switch.[% boiler %]
        state: "on"
    actions:
      - action: input_boolean.turn_on
        entity_id: input_boolean.[% boiler %]_hot

  # Reset the boiler state at midnight.
  - id: Automation__ExsBoiler_Reset
    alias: ExsBoiler Reset
    initial_state: false
    triggers:
      - trigger: time
        at: "00:00:00"
    actions:
      - action: input_boolean.turn_off
        entity_id: input_boolean.[% boiler %]_hot

  # Turn off when disabled.
  - id: Automation__ExsBoiler_Enabled
    alias: "ExsBoiler Enabled"
    mode: single
    triggers:
      - trigger: state
        entity_id: input_boolean.[% boiler %]_enabled
        to: "off"
    actions:
      - action: switch.turn_off
        entity_id: switch.[% boiler %]

  # Turn off when disabled.
  - id: Automation__ExsHeater1_Enabled
    alias: "ExsHeater Enabled"
    mode: single
    triggers:
      - trigger: state
        entity_id: input_boolean.[% heater1 %]_enabled
        to: "off"
    actions:
      - action: switch.turn_off
        entity_id: switch.[% heater1 %]

  # Turn off when disabled.
  - id: Automation__ExsHeater2_Enabled
    alias: "ExsHeater Enabled"
    mode: single
    triggers:
      - trigger: state
        entity_id: input_boolean.[% heater2 %]_enabled
        to: "off"
    actions:
      - action: switch.turn_off
        entity_id: switch.[% heater2 %]

  # Turn keukenboiler on/off with clock program.
  - id: Automation__Keukenboiler_Schedule
    alias: Keukenboiler Schedule
    description: 'Turn keukenboiler on/off with clock program.'
    mode: single

    triggers:
      - trigger: numeric_state
        entity_id: number.thermostat_hc1_seltemp
        below: 17.9
        id: trigger-below
      - trigger: numeric_state
        entity_id: number.thermostat_hc1_seltemp
        above: 17.9
        id: trigger-above

    actions:
      - choose:
          - conditions:
              - condition: trigger
                id: trigger-below
            sequence:
              - action: switch.turn_off
                target:
                  entity_id: switch.keukenboiler
          - conditions:
              - condition: trigger
                id: trigger-above
            sequence:
              - action: switch.turn_on
                target:
                  entity_id: switch.keukenboiler

template:

  - sensor:
      - name: Energie balans
        unique_id: power_energie_balans
        device_class: power
        unit_of_measurement: kW
        state: >-
          {{
          states('sensor.dsmr_reading_electricity_currently_returned')|float
          -
          states('sensor.dsmr_reading_electricity_currently_delivered')|float
          }}

      - name: Energie Overschot
        unique_id: power_energie_overschot
        unit_of_measurement: W
        state: >-
          {{
          ( states('sensor.energie_balans')|float * 1000
            +
            states('sensor.[% heater1 %]_energy_power')|float
            +
            states('sensor.[% heater2 %]_energy_power')|float
            +
            states('sensor.[% boiler %]_energy_power')|float ) |float(2)
          }}
          
      # Constant consumption: 175W
      - name: Computers Power
        unique_id: computers_power
        device_class: power
        unit_of_measurement: kW
        state: 0.175

      # Constant consumption: 8.5W
      - name: Traplift Power
        unique_id: traplift_power
        device_class: power
        unit_of_measurement: kW
        state: 0.0085

      - name: EcoFLow Battery Charging Power
        unique_id: ecoflow_battery_charging_power
        device_class: power
        unit_of_measurement: W
        state: "{{ -(states('sensor.energy_battery_ecoflow_stream_ac_5000_battery_discharge_power_ecoflow_stream_ac_5000_battery_charge_power_net_power')|int)}}"
        
  - binary_sensor:
      - name: Energie Overschot
        unique_id: power_energie_overschot
        device_class: power
        state: "{{ states('sensor.energie_balans')|float > 0}}"

input_boolean:

  [% heater1 %]_enabled:
    name: EXS Heater1

  [% heater2 %]_enabled:
    name: EXS Heater2

  [% boiler %]_enabled:
    name: EXS Boiler

  [% boiler %]_hot:
    name: EXS Boiler Hot

sensor:

  - platform: integration
    source: sensor.computers_power
    name: Computers Energy
    unique_id: computers_energy
    round: 2
    max_sub_interval:
      minutes: 5

  - platform: integration
    source: sensor.traplift_power
    name: Traplift Energy
    unique_id: traplift_energy
    round: 2
    max_sub_interval:
      minutes: 5

