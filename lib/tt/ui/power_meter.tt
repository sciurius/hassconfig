[%- # -*- mode: tt; indent-tabs-mode: nil -*-
   DEFAULT sensor = name.lower;
   sensor = "sensor." _ sensor _ "_energy_today";

WRAPPER mt_card.tt
           entity = sensor
           name = name
           visible = "available >0"
           %]
[% IF icon %]        icon: mdi:[% icon %][% END %]
        primary: [% name %]
        color: var(--state-icon-color)
        secondary: "{{ states('[% sensor %]')|round(2) }} kWh"
        icon_tap_action:
          action: more-info
        icon_hold_action:
          action: more-info
[% END %]
