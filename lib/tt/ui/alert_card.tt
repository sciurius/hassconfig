[%

# For conditional alert card.

DEFAULT name    = "";
DEFAULT icon    = "mdi:alert";
DEFAULT icon_color = "orange";
DEFAULT indent  = 0;
DEFAULT condition = "state";
DEFAULT cstate    = "";

Ind = PROCESS get_indent.tt indent = indent;

message = message.replace( '\bentity\b', "'" _ entity _ "'" );

IF ( v_m = condition.match('^([<>])(.*)') );
    condition = "numeric_state";
    IF v_m.0 == '<'; 
      cstate = "below: " _ v_m.1;
    ELSE;
      cstate = "above: " _ v_m.1;
    END;
END;

IF condition == "state"
   && cstate == ""
   && entity.match('^(binary_sensor|input_boolean)\.');
   cstate = "state: 'on'";
END;

-%]
type: conditional
[% FILTER indent( Ind.length ) -%]
conditions:
- condition: or
  conditions:
  - condition: [% condition %]
    entity: [% entity %]
    [% cstate %]
  - condition: state
    entity: input_boolean.testing_alerts
    state: "on"
card:
  type: custom:alert-ticker-card
  alerts:
  - entity: [% entity %]
    message: "[% message %]"
    theme: warning
    use_ha_icon: true
    icon: "[% icon %]"
    icon_color: "[% icon_color %]"
    disable_animation: true
[% END;

# Finally, the rest of the card content, with additional indent.

content.remove('^\n+') | indent(2);

-%]
