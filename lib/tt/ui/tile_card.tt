[%

# For tile and tile-based cards cards.
# Special treatment in custom:grid-layout.

DEFAULT type    = "tile";
DEFAULT name    = "";
DEFAULT icon    = "";
DEFAULT span    = 1;
DEFAULT indent  = 0;
DEFAULT visible = "";
DEFAULT color   = "";

ind = PROCESS get_indent.tt indent = indent;

# Use a wrapping conditional card for visibility.
IF visible;
"type: conditional\n";
ind; "conditions:\n";

reverse = 0;
a = visible.split(' +');

FOREACH v IN a;
  IF v == "not"; reverse = !reverse;

  ELSIF v == "active";
    ind; "- condition: state\n";
    ind; "  entity: "; entity; "\n";
    ind; "  state"; IF reverse; "_not"; END; ": active\n";
    reverse = 0;

  ELSIF v == "available";
    ind; "- condition: state\n";
    ind; "  entity: "; entity; "\n";
    ind; "  state"; IF !reverse; "_not"; END; ":\n";
    ind; "    - unavailable\n";
    ind; "    - unknown\n";
    reverse = 0;

  # < and > indicate "below" and "above". Note that "not" is ignored.
  ELSIF ( m = v.match('^([<>])(.*)') );
    ind; "- condition: numeric_state\n";
    ind; "  entity: "; entity; "\n";
    IF m.0 == '<'; 
      ind; "  below; "; m.1; "\n";
    ELSE;
      ind; "  above: "; m.1; "\n";
    END;
    reverse = 0;

  # Assume state match.
  ELSE;
    IF ( v_or = v.split("\\\|") ) && v_or.size > 1;
      ind; "- condition: "; IF reverse; "and"; ELSE; "or"; END; "\n";
      ind; "  conditions:\n";
      FOREACH vv IN v_or;
          ind; "  - condition: state\n";
          ind; "    entity: "; entity; "\n";
          ind; "    state"; IF reverse; "_not"; END; ": \""; vv; "\"\n";
      END;
    ELSIF ( v_and = v.split("&") ) && v_and.size > 1;
      ind; "- condition: state\n";
      ind; "  entity: "; entity; "\n";
      ind; "  state"; IF reverse; "_not"; END; ":\n";
      FOREACH vv IN v_and;
          ind; "    - \""; vv; "\"\n";
      END;
    ELSE;
      ind; "- condition: state\n";
      ind; "  entity: "; entity; "\n";
      ind; "  state"; IF reverse; "_not"; END; ": \""; v; "\"\n";
    END;
    reverse = 0;
  END;

END;

ind; "card:\n";
ind = "  " _ ind;
ind;
END;

# Card type.
IF    type == "mt"; cardtype = "custom:mushroom-template-card";
ELSIF type == "hg"; cardtype = "custom:horizontal-gauge-card";
ELSE;               cardtype = "tile"; END;
"type: "; cardtype; "\n";

# grids (custom:grid-layout-card) need some card mods.
IF sections == 'grids';
ind; "card_mod:\n";
ind; "  style: ':host { --masonry-view-card-margin: 3px; }'\n";
END;

# Parameters, if any.
IF name;
  IF type == "tile" || type == "hg";
    ind; "name: "; name; "\n";
  ELSIF type == "mt";
    ind; "primary: "; name; "\n";
  END;
END;
IF entity;      ind; "entity: "; entity; "\n"; END;
IF icon;        ind; "icon: "; icon; "\n"; END;
IF color;
  IF type == "hg" && color == "segment";
    ind; "icon_color_from_segment: true\n";
  ELSE;
    ind; "color: "; color; "\n";
  END;
END;

# Only grids and sections can do this.
IF span > 1;
  SWITCH sections;
  CASE 'grids';
    ind; "view_layout:\n";
    ind; "  grid-column: 1 / span "; span; "\n";
  CASE 'sections';
    ind; "grid_options:\n";
    ind; "  columns: "; 6 * span; "\n";
  END;
END;

# Finally, the rest of the card content.
content = content.remove('^\n+');
IF visible; content | indent(2); ELSE; content; END;

-%]
